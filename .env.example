# Database connection string (PostgreSQL).
# Local example: postgresql://user:password@localhost:5432/craftthink_business
# On Vercel: use Vercel Postgres, Neon, or Supabase and paste its connection string here.
DATABASE_URL="postgresql://user:password@localhost:5432/craftthink_business"

# Secret used to sign session JWTs. Use a long random value (32+ characters).
# Generate one with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-secret"

# First-run admin seeding only (used by POST /api/auth/seed).
ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD is ONLY for first-run seeding and must be changed after first login.
# NEVER hardcode a real password anywhere in the codebase.
ADMIN_PASSWORD="change-me-after-first-login"

# Dev-only seed gate. Keep false/absent outside local development.
# SEED_DEV=true

